# ==================== Telegram ====================
BOT_TOKEN=123456:ABC-your-telegram-bot-token
BOT_ADMIN_IDS=111111111,222222222

# ==================== Django ====================
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_INTERNAL_API_TOKEN=change-me-shared-secret-between-bot-and-backend

# ==================== PostgreSQL ====================
POSTGRES_DB=video_bot
POSTGRES_USER=video_bot
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ==================== Redis ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ==================== Celery ====================
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ==================== ACRCloud ====================
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=your-access-key
ACRCLOUD_ACCESS_SECRET=your-access-secret

# ==================== Backend URL (used by bot) ====================
BACKEND_BASE_URL=http://django_backend:8000

# ==================== Limits ====================
MAX_FILE_SIZE_MB=200
FREE_DAILY_DOWNLOAD_LIMIT=15
PREMIUM_DAILY_DOWNLOAD_LIMIT=200
DOWNLOAD_RATE_LIMIT_SECONDS=3

# ==================== Payments (premium, optional) ====================
STRIPE_API_KEY=
TELEGRAM_PAYMENTS_PROVIDER_TOKEN=
CLICK_MERCHANT_ID=
PAYME_MERCHANT_ID=
